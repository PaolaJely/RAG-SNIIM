# =============================================================================
# RAG-SNIIM — Variables de entorno
# Copiar a .env en la raíz: cp .env.example .env
# =============================================================================

# ── Desarrollo local (docker compose up -d) ───────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sniim

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sniim
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=prefer

# ── Producción: Qdrant Cloud (comentar QDRANT_HOST/PORT si usas solo cloud) ─
# QDRANT_URL=https://xxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=tu-api-key-de-qdrant-cloud

# ── Producción: Neon Postgres (sslmode=require obligatorio) ─────────────────
# Puedes usar una URL completa en lugar de las variables separadas.
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#
# POSTGRES_HOST=ep-xxxx.region.aws.neon.tech
# POSTGRES_DB=neondb
# POSTGRES_USER=neondb_owner
# POSTGRES_PASSWORD=tu_password
# POSTGRES_SSLMODE=require

# Protege los endpoints que escriben importaciones en Neon.
# Usa un valor largo y aleatorio; el operador lo introduce en el módulo.
IMPORT_ADMIN_TOKEN=cambia-por-un-secreto-seguro

# ── OpenAI embeddings ───────────────────────────────────────────────────────
# Se mantiene para consultar la colección Qdrant ya indexada con este modelo.
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── DeepSeek LLM ────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled

# ── RAG ─────────────────────────────────────────────────────────────────────
SEARCH_K=16
SIMILARITY_THRESHOLD=0.2

# ── Frontend (solo build Cloudflare Pages — ver frontend/.env.example) ──────
# VITE_API_URL=https://tu-api.onrender.com
